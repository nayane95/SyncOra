# Browser configuration. Only VITE_ variables are exposed to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deployment only. Never prefix these with VITE_ or commit populated values.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# One-time trusted admin seed only. Never expose these to Vite.
SUPABASE_SERVICE_ROLE_KEY=
SEED_ADMIN_EMAIL=super-admin@example.com
SEED_ADMIN_PASSWORD=
